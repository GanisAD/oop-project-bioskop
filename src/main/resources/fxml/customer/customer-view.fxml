<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.CustomerController"
           style="-fx-background-color: transparent;">

    <!-- ========================================================
         VIEW 1: KATALOG FILM & JADWAL
         ======================================================== -->
    <VBox fx:id="catalogPane" spacing="16.0">
        <!-- Catalog Header -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox spacing="4.0">
                <Label text="SEDANG TAYANG DI BIOSKOP" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" />
                <Label text="Pilih film dan jadwal tayang yang diinginkan untuk memesan kursi" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtSearchFilm" promptText="🔍 Cari judul film atau genre..." prefWidth="280.0" />
        </HBox>

        <!-- Movie List Container -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox fx:id="movieContainer" spacing="20.0">
                <padding>
                    <Insets top="5.0" right="10.0" bottom="20.0" left="5.0" />
                </padding>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- ========================================================
         VIEW 2: DENAH KURSI & RINGKASAN PEMESANAN
         ======================================================== -->
    <VBox fx:id="seatSelectionPane" spacing="14.0" visible="false">
        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Button fx:id="btnBackToCatalog" text="← Kembali ke Katalog" onAction="#handleBackToCatalog" styleClass="btn-secondary" />
            <VBox spacing="2.0">
                <Label fx:id="lblSelectedMovieTitle" text="Judul Film" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" />
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label fx:id="lblSelectedStudio" text="Studio 1" styleClass="badge-tag" />
                    <Label fx:id="lblSelectedTime" text="Tayang: 19:30" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblSelectedBasePrice" text="Rp 45.000 / tiket" style="-fx-font-size: 12px; -fx-text-fill: #10B981; -fx-font-weight: bold;" />
                </HBox>
            </VBox>
        </HBox>

        <!-- Main Workspace (Seats on Left, Summary on Right) -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <!-- Studio Seat Map -->
            <VBox spacing="18.0" HBox.hgrow="ALWAYS" styleClass="card-panel" alignment="TOP_CENTER">
                <Label text="PILIH KURSI BIOSKOP" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #F8FAFC;" />

                <!-- Cinema Screen Indicator -->
                <VBox alignment="CENTER" maxWidth="500.0" styleClass="cinema-screen">
                    <Label text="─────────────── LAYAR BIOSKOP / SCREEN ───────────────" 
                           style="-fx-font-size: 11px; -fx-text-fill: #F59E0B; -fx-font-weight: bold;" />
                </VBox>

                <!-- Dynamic Seat Matrix Grid -->
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <StackPane>
                        <GridPane fx:id="gridKursi" alignment="CENTER" hgap="10.0" vgap="10.0">
                            <padding>
                                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                            </padding>
                        </GridPane>
                    </StackPane>
                </ScrollPane>

                <!-- Legend Indicator -->
                <HBox alignment="CENTER" spacing="25.0">
                    <HBox alignment="CENTER" spacing="8.0">
                        <Label styleClass="seat-btn, seat-available" text="" prefWidth="22.0" prefHeight="20.0" minWidth="22.0" minHeight="20.0" />
                        <Label text="Tersedia" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                    </HBox>
                    <HBox alignment="CENTER" spacing="8.0">
                        <Label styleClass="seat-btn, seat-selected" text="" prefWidth="22.0" prefHeight="20.0" minWidth="22.0" minHeight="20.0" />
                        <Label text="Pilihan Anda" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                    </HBox>
                    <HBox alignment="CENTER" spacing="8.0">
                        <Label styleClass="seat-btn, seat-sold" text="" prefWidth="22.0" prefHeight="20.0" minWidth="22.0" minHeight="20.0" />
                        <Label text="Sudah Terisi" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                    </HBox>
                </HBox>
            </VBox>

            <!-- Order Summary Sidebar -->
            <VBox spacing="16.0" prefWidth="350.0" minWidth="320.0" styleClass="card-panel">
                <Label text="RINGKASAN PEMESANAN" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" />
                <Separator style="-fx-background-color: #334155;" />

                <!-- Kursi Terpilih -->
                <VBox spacing="4.0">
                    <Label text="Kursi Yang Dipilih" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="lblKursiTerpilih" text="(Belum ada kursi)" 
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" />
                        <Label fx:id="lblStatusKursiBadge" text="PILIH 1 KURSI" styleClass="badge-tag" />
                    </HBox>
                </VBox>

                <!-- Tipe Tiket Selector -->
                <VBox spacing="8.0">
                    <Label text="Pilihan Tipe Tiket" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                    <VBox spacing="6.0">
                        <fx:define>
                            <ToggleGroup fx:id="tipeTiketGroup" />
                        </fx:define>
                        <RadioButton fx:id="rbTiketReguler" text="Reguler (Standar)" toggleGroup="$tipeTiketGroup" selected="true" />
                        <RadioButton fx:id="rbTiketVIP" text="VIP (+Rp 25.000 - Recliner &amp; Snack)" toggleGroup="$tipeTiketGroup" />
                    </VBox>
                </VBox>

                <Separator style="-fx-background-color: #334155;" />

                <!-- Form Data Pelanggan -->
                <VBox spacing="10.0">
                    <Label text="DATA PEMESAN" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" />
                    <VBox spacing="4.0">
                        <Label text="Nama Lengkap" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                        <TextField fx:id="txtNamaPelanggan" promptText="Masukkan nama pemesan..." />
                    </VBox>
                    <VBox spacing="4.0">
                        <Label text="Nomor HP / WhatsApp" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
                        <TextField fx:id="txtNoHpPelanggan" promptText="08xxxxxxxxxx" />
                    </VBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
                <Separator style="-fx-background-color: #334155;" />

                <!-- Total Biaya -->
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total Pembayaran" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalHarga" text="Rp 0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" />
                    </HBox>
                </VBox>

                <!-- Tombol Konfirmasi -->
                <Button fx:id="btnKonfirmasiPesan" text="KONFIRMASI &amp; BAYAR TIKET" 
                        onAction="#handleKonfirmasiPemesanan"
                        maxWidth="Infinity" styleClass="btn-gold" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ========================================================
         VIEW 3: E-TIKET & STRUK TRANSAKSI SUKSES
         ======================================================== -->
    <VBox fx:id="receiptPane" alignment="CENTER" spacing="20.0" visible="false">
        <VBox alignment="CENTER" spacing="15.0" maxWidth="480.0" styleClass="ticket-card">
            <!-- Header Ticket -->
            <HBox alignment="CENTER" spacing="10.0">
                <Label text="🍿 CINEMA XXI" styleClass="brand-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblReceiptKodeBooking" text="BOOK-0001" styleClass="badge-tag" 
                       style="-fx-background-color: #F59E0B; -fx-text-fill: #0F172A; -fx-font-weight: bold; -fx-font-size: 12px;" />
            </HBox>

            <Label text="PEMESANAN TIKET BERHASIL!" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10B981;" />

            <Separator styleClass="ticket-dashed-line" />

            <!-- Details -->
            <VBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                <HBox>
                    <Label text="Film" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptFilm" text="Avatar: The Way of Water" style="-fx-text-fill: #F8FAFC; -fx-font-weight: bold;" />
                </HBox>
                <HBox>
                    <Label text="Studio" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptStudio" text="Studio 1" style="-fx-text-fill: #F8FAFC;" />
                </HBox>
                <HBox>
                    <Label text="Waktu Tayang" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptWaktu" text="25-09-2026 19:30" style="-fx-text-fill: #F8FAFC;" />
                </HBox>
                <HBox>
                    <Label text="Kursi" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptKursi" text="B4" style="-fx-text-fill: #F59E0B; -fx-font-weight: bold; -fx-font-size: 14px;" />
                </HBox>
                <HBox>
                    <Label text="Tipe Tiket" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptTipe" text="Reguler" style="-fx-text-fill: #F8FAFC;" />
                </HBox>
                <HBox>
                    <Label text="Nama Pemesan" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptNama" text="Ganis" style="-fx-text-fill: #F8FAFC;" />
                </HBox>
                <HBox>
                    <Label text="Nomor HP" prefWidth="120.0" style="-fx-text-fill: #94A3B8;" />
                    <Label fx:id="lblReceiptNoHp" text="08123456789" style="-fx-text-fill: #F8FAFC;" />
                </HBox>
            </VBox>

            <Separator styleClass="ticket-dashed-line" />

            <HBox alignment="CENTER_LEFT">
                <Label text="Total Pembayaran" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblReceiptTotal" text="Rp 45.000" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" />
            </HBox>

            <!-- Barcode Mockup -->
            <VBox alignment="CENTER" spacing="4.0" style="-fx-padding: 10 0 0 0;">
                <Label text="||||| ||| ||||||| |||| |||||| ||||| ||||||" 
                       style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 22px; -fx-text-fill: #CBD5E1; -fx-letter-spacing: 2px;" />
                <Label text="Tunjukkan struk e-tiket ini kepada petugas studio bioskop" style="-fx-font-size: 10px; -fx-text-fill: #64748B;" />
            </VBox>

            <!-- Action Button -->
            <Button text="Selesai &amp; Pesan Tiket Baru" onAction="#handleFinishBooking" 
                    maxWidth="Infinity" styleClass="btn-gold" />
        </VBox>
    </VBox>

</StackPane>
